__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
# madmom needs its own interpreter (PyPI 0.16.1 is py<3.10 only) -- see
# scripts/madmom_worker.py. Never committed.
.venv-madmom/
.env
*.so
.pytest_cache/
.coverage
htmlcov/
audio/
*.aif
*.aiff
*.wav
*.mp3
video/
*.mp4
*.mov
*.avi
*.mkv
.DS_Store

# mkdocs build output
site/

# eval run artifacts (bless promotes one to evals/baseline.json)
evals/runs/

# DEV-split eval audio IS committed (cloud agent sessions clone fresh and
# need to hear it — docs/research/agent-environment.md). SEALED clips must
# never be committed: owner's machine only. Order matters: these negations
# override the media ignores above for audio/rig/*.mp3 and nothing else.
!audio/
audio/*
!audio/rig/
audio/rig/*
!audio/rig/*.mp3

# Agent runner logs: the raw stream-json transcript is NEVER committed (~1 MB/run,
# can quote personal teacher-video speech, and a directory listing in it would
# encode the HELD-OUT split by absence). The per-run summary IS committed.
logs/*
!logs/run-summaries.md
